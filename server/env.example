# Copy to server/.env and fill in:  cp server/env.example server/.env
# Never commit the real file or the .p8 key.

# --- APNs -------------------------------------------------------------------
# Apple Developer -> Certificates, Identifiers & Profiles -> Keys ->
# create a key with "Apple Push Notifications service (APNs)" enabled.
# The .p8 downloads exactly once.
APNS_KEY_ID=ABCD1234EF
APNS_TEAM_ID=1234ABCDEF
APNS_KEY_PATH=./AuthKey_ABCD1234EF.p8

# Must match ios.bundleIdentifier in app.json.
APNS_TOPIC=com.remycamera.alerts

# true  -> api.sandbox.push.apple.com  (development builds, `expo run:ios`)
# false -> api.push.apple.com          (App Store and TestFlight builds)
# Tokens are NOT interchangeable; the wrong host returns BadDeviceToken.
APNS_USE_SANDBOX=true

# Filename of the bundled sound, or "default".
# Must match a file in assets/sounds/ listed under the expo-notifications plugin.
CRITICAL_SOUND=remy-critical.wav

# --- Service ----------------------------------------------------------------
# Shared secret the mobile app sends as x-api-key. Ships in the app bundle, so
# treat it as low-value: it only gates registration and reads.
# Generate: openssl rand -hex 24
API_KEY=

# Secret for POST /api/alerts, the endpoint that actually sends pushes.
# Only remy-camera's backend should hold this. Never put it in the app.
INTERNAL_API_KEY=

DATABASE_PATH=./data/remy.db
