# Copy to .env at the repo root:  cp env.example .env
#
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time, so
# everything here is readable by anyone with the .ipa. That is fine for these —
# they are all publishable values.

# The deployed Remy control plane. This is the ONLY backend URL the app needs:
# GET /me/sites returns each home the signed-in caregiver can see, along with
# that home's own endpoint. Without it the app has nowhere to look.
#   e.g. https://control-plane-xxxx.up.railway.app
EXPO_PUBLIC_CONTROL_PLANE_URL=

# Supabase project — the same identity as the remy-camera web app, so one Remy
# account signs into both. Defaults are baked into src/lib/config.ts; override
# here only to point at a different project.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
