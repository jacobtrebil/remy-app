# Copy to .env at the repo root:  cp env.example .env
#
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time. Anything
# here is readable by anyone with the .ipa — never put the APNs key or
# INTERNAL_API_KEY in this file.

# Base URL of the push service in server/.
# Leave unset during development and the app falls back to http://<expo-host>:8000,
# which is usually what you want on a device connected to the same wifi.
EXPO_PUBLIC_API_URL=

# Must match API_KEY in server/.env.
EXPO_PUBLIC_API_KEY=
