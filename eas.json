{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_API_URL": ""
      }
    },

    "preview": {
      "distribution": "internal",
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://alerts.remycamera.com"
      }
    },

    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://alerts.remycamera.com"
      }
    },

    "production-critical": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://alerts.remycamera.com",
        "REMY_CRITICAL_ALERTS": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "jacobtrebil@gmail.com",
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "REPLACE_WITH_APPLE_TEAM_ID"
      }
    }
  }
}
