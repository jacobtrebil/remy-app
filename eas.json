{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_CONTROL_PLANE_URL": "https://REPLACE-WITH-CONTROL-PLANE.up.railway.app"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_CONTROL_PLANE_URL": "https://REPLACE-WITH-CONTROL-PLANE.up.railway.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_CONTROL_PLANE_URL": "https://REPLACE-WITH-CONTROL-PLANE.up.railway.app"
      }
    },
    "production-critical": {
      "extends": "production",
      "env": {
        "REMY_CRITICAL_ALERTS": "1",
        "EXPO_PUBLIC_CONTROL_PLANE_URL": "https://REPLACE-WITH-CONTROL-PLANE.up.railway.app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "jacobtrebil@gmail.com"
      }
    }
  }
}
